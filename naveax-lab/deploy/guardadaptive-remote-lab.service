# GuardAdaptive Remote Lab: separate, locally bound website process.
# Review on the actual Ubuntu host before installation; do not enable public
# traffic until its HTTPS reverse proxy, DNS, consent and legal basis are ready.
[Unit]
Description=GuardAdaptive Remote Lab (controller-readonly volunteer data research)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/guardadaptive-remote-lab
ExecStart=/usr/bin/node /opt/guardadaptive-remote-lab/server.cjs
Environment=NODE_ENV=production
Environment=REMOTE_LAB_HOST=127.0.0.1
Environment=REMOTE_LAB_PORT=48927
Environment=REMOTE_LAB_DATA_DIR=/var/lib/guardadaptive-remote-lab
EnvironmentFile=/etc/guardadaptive-remote-lab/service.env
LoadCredential=admin_token:/etc/guardadaptive-remote-lab/admin_token
StateDirectory=guardadaptive-remote-lab
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/guardadaptive-remote-lab
Restart=on-failure
RestartSec=3s
TimeoutStartSec=20s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
